# ==============================================================================
# Strapi Blog - Environment Configuration
# Copy this file to .env and customize before running:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Reverse Proxy (Nginx)
# ------------------------------------------------------------------------------
# External HTTP port exposed by Nginx
APP_PORT=8080

# Public URL where visitors access the blog (used for SEO canonical URLs, RSS, Sitemaps, and Strapi proxy)
# Example for production: https://blog.example.com
PUBLIC_SITE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Multi-site & Localization (Frontend + Seed)
# ------------------------------------------------------------------------------
# Default language when visiting paths without a locale prefix (e.g. /life)
# Supported built-in UI locales: zh-Hans, en
DEFAULT_LOCALE=zh-Hans

# Comma-separated enabled locales (must match Strapi i18n locale codes)
SUPPORTED_LOCALES=zh-Hans,en

# Optional: set to a site slug (e.g. "life") if "/" should redirect directly to that blog
# Leave empty to show the multi-site Portal page at "/"
DEFAULT_SITE_SLUG=

# Built-in theme preset fallback (also configurable per-site in Strapi Admin)
# Options: default | warm | anime | cyber
DEFAULT_THEME=default

# Site title / brand shown on the multi-site portal when DEFAULT_SITE_SLUG is empty
NEXT_PUBLIC_PORTAL_NAME=Strapi Multi-Site Blog

# ------------------------------------------------------------------------------
# Database Configuration (Strapi Backend)
# ------------------------------------------------------------------------------
# Supported values: sqlite | postgres | mysql
# - sqlite (default): Zero-config, persists in ./data/strapi-db or Docker volume. Just run `docker compose up -d`
# - postgres: Run with `docker compose --profile postgres up -d` (or point DATABASE_HOST to external DB)
# - mysql: Run with `docker compose --profile mysql up -d` (or point DATABASE_HOST to external DB)
DATABASE_CLIENT=sqlite

# SQLite settings (used when DATABASE_CLIENT=sqlite)
DATABASE_FILENAME=/app/data/data.db

# PostgreSQL / MySQL settings (used when DATABASE_CLIENT=postgres or mysql)
# Note: when using the bundled compose profile, set DATABASE_HOST=postgres or DATABASE_HOST=mysql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi_blog
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change_me_db_password
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# Strapi Security Secrets
# ------------------------------------------------------------------------------
# Leave empty for auto-generation on first boot (persisted in backend data volume).
# For multi-instance or deterministic deployments, set strong random values!
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Strapi Features: MCP, Comments, Demo Seed
# ------------------------------------------------------------------------------
# Enable Strapi v5 built-in MCP Server at /mcp (for Cursor / Claude / AI writing)
STRAPI_MCP_ENABLED=true

# Auto-seed the default /life demo site & sample multilingual Markdown post on first empty boot
SEED_DEMO_DATA=true

# Enable/disable comments UI on frontend (true | false)
NEXT_PUBLIC_COMMENTS_ENABLED=true

# Require moderation approval for newly submitted comments (true | false)
COMMENTS_REQUIRE_APPROVAL=false

# ------------------------------------------------------------------------------
# Internal Networking (Usually no need to change in Docker Compose)
# ------------------------------------------------------------------------------
STRAPI_INTERNAL_URL=http://backend:1337
STRAPI_PUBLIC_URL=
STRAPI_API_TOKEN=
